# Copy to .env on the VM (never commit it) and replace every value.

# Image to run; CI publishes ghcr.io/<owner>/<repo>:latest
SEATLOCK_IMAGE=ghcr.io/OWNER/REPO:latest

# Public hostname; Caddy gets a TLS certificate for it. DNS A record must point at the VM.
SEATLOCK_DOMAIN=seatlock.example.com

# HS256 signing key, used as-is: must be at least 32 bytes (the app will not start otherwise).
# Generate with: openssl rand -hex 32   (64 characters)
SEATLOCK_AUTH_JWT_SECRET=

POSTGRES_PASSWORD=

# Grafana admin password (anonymous visitors get read-only Viewer access)
GF_ADMIN_PASSWORD=
